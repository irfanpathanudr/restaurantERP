# ================================
# Template — START_ALL.bat writes backend/.env automatically
# Copy manually only if you are not using START_ALL.bat
# ================================

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=restaurant_erp

PORT=5000
NODE_ENV=development
HOST=0.0.0.0

JWT_SECRET=your_jwt_secret_key_min_32_characters_long_change_production
JWT_REFRESH_SECRET=refresh_secret_key_min_32_characters_long_change_prod
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Include frontend (3000), KOT (3001), and Vite default (5173) + your LAN IP
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://192.168.0.113:3000,http://192.168.0.113:3001

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

APP_URL=http://192.168.0.113:5000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
LOG_LEVEL=info
