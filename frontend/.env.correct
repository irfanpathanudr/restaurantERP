# ================================
# Template — START_ALL.bat writes frontend/.env automatically
# ================================
# Base server URL ONLY (no /api/v1). Path is added via VITE_API_BASE_PATH.
# Use your PC LAN IP so phones on Wi-Fi can reach the API.

VITE_API_URL=http://192.168.0.113:5000
VITE_API_BASE_PATH=/api/v1
