{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "Complete Production Ready Restaurant ERP + POS Management System",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migration:generate": "npm run migration:generate --workspace=backend",
    "migration:run": "npm run migration:run --workspace=backend",
    "seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "restaurant",
    "erp",
    "pos",
    "management",
    "typescript",
    "react",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "",
  "license": "MIT"
}
